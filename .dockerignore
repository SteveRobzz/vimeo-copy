# Build context for the worker image. Everything below is regenerated inside
# the image (fresh Linux install) or must never ship into it (secrets).
**/node_modules
.git
.gitignore
**/.next
dist
build
out
**/*.tsbuildinfo
*.log
tmp
uploads
# Prisma client is regenerated by @vp/db postinstall inside the image.
packages/db/generated
# Never bake local secrets into the image.
.env
**/.env
**/.env.local
**/.env.*.local
