// Prisma schema for the video platform MVP.
// Owned by @vp/db; imported by both the web app and the worker.

generator client {
  provider = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" is the query engine for
  // Vercel's serverless (AWS Lambda / Amazon Linux) runtime. Without this the
  // client can't locate an engine at runtime and every DB call 500s.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Runtime (pooled) connection — Supabase pooler in prod, direct locally.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations/DDL. Falls back to
  // DATABASE_URL locally where the two are the same.
  directUrl = env("DIRECT_URL")
}

enum Privacy {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum VideoStatus {
  UPLOADING // client is still pushing bytes (resumable upload in flight)
  QUEUED // upload complete, transcode job enqueued
  PROCESSING // worker is probing/transcoding/packaging
  READY // HLS renditions + captions available
  ERROR // pipeline failed; see errorMessage
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String? // null until we wire the chosen auth strategy
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  videos Video[]
  views  View[]
}

model Video {
  id           String      @id @default(cuid())
  owner        User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId      String
  title        String
  description  String?
  privacy      Privacy     @default(PRIVATE)
  status       VideoStatus @default(UPLOADING)
  errorMessage String?

  // Source (raw upload) metadata — filled in by ffprobe in the worker.
  originalFilename String?
  sourceObjectKey  String? // object-storage key for the raw upload
  durationSeconds  Float?
  sourceWidth      Int?
  sourceHeight     Int?
  sourceCodec      String?

  // Playback outputs — filled in by the worker once packaging succeeds.
  hlsMasterKey String? // master .m3u8 key (references the variant playlists)
  thumbnailKey String?

  // Denormalized counter for the dashboard; View holds the per-event detail.
  viewCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  renditions Rendition[]
  captions   Caption[]
  views      View[]

  @@index([ownerId])
  @@index([status])
  @@index([privacy])
}

model Rendition {
  id            String   @id @default(cuid())
  video         Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId       String
  label         String // "360p", "480p", "720p", "1080p"
  width         Int
  height        Int
  bitrateKbps   Int
  codec         String   @default("h264")
  playlistKey   String // variant .m3u8 key for this rung
  fileSizeBytes BigInt?
  vmafScore     Float? // optional VMAF score (stretch goal) for preset comparison
  createdAt     DateTime @default(now())

  @@unique([videoId, label])
  @@index([videoId])
}

model Caption {
  id              String   @id @default(cuid())
  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId         String
  language        String // BCP-47, e.g. "en"
  label           String // human label, e.g. "English (auto)"
  isAutoGenerated Boolean  @default(true)
  isDefault       Boolean  @default(false)
  objectKey       String // .vtt key in object storage
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([videoId, language])
  @@index([videoId])
}

model View {
  id             String   @id @default(cuid())
  video          Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId        String
  viewer         User?    @relation(fields: [viewerId], references: [id], onDelete: SetNull)
  viewerId       String?
  ipHash         String? // hashed IP for light dedup — never store the raw IP
  watchedSeconds Float?
  createdAt      DateTime @default(now())

  @@index([videoId])
  @@index([videoId, createdAt])
}
