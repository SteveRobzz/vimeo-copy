# Worker env. Copy to .env for local dev (mirrors apps/web/.env.local).
DATABASE_URL="postgresql://vp:vp@localhost:5432/vp?schema=public"
DIRECT_URL="postgresql://vp:vp@localhost:5432/vp?schema=public"
REDIS_URL="redis://localhost:6379"

# Object storage — local MinIO (S3-compatible). Prod = Supabase Storage.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minio"
S3_SECRET_ACCESS_KEY="minio12345"
S3_BUCKET="vp-media"
S3_FORCE_PATH_STYLE="true"

# --- Transcode tuning ---
# How many jobs to run at once. FFmpeg is CPU-heavy; keep low on a laptop.
WORKER_CONCURRENCY="1"
# x264 speed/quality tradeoff (ultrafast..placebo). veryfast is a good default.
FFMPEG_PRESET="veryfast"
# Override if ffmpeg/ffprobe aren't on PATH (e.g. absolute path to the .exe).
# FFMPEG_PATH="ffmpeg"
# FFPROBE_PATH="ffprobe"

# --- Captions (Whisper ASR) ---
# Auto-generate captions if a whisper CLI is available. Set to "false" to skip.
ENABLE_CAPTIONS="true"
# Whisper CLI to invoke (openai-whisper: "whisper", or a whisper.cpp wrapper).
WHISPER_BIN="whisper"
# Model size for openai-whisper (tiny/base/small/medium/large). tiny = fastest.
WHISPER_MODEL="tiny"
