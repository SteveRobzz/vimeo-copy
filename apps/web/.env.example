# Next.js app env. Copy to .env.local for local dev.
# Runtime (pooled) connection. Locally = direct Postgres; prod = Supabase pooler.
DATABASE_URL="postgresql://vp:vp@localhost:5432/vp?schema=public"
# Direct (non-pooled) connection for Prisma migrations. Locally same as above;
# prod = Supabase direct connection (port 5432).
DIRECT_URL="postgresql://vp:vp@localhost:5432/vp?schema=public"
# Local = local Redis; prod = Upstash (use the rediss:// TLS URL).
REDIS_URL="redis://localhost:6379"

# Object storage. Local dev = MinIO; prod = Supabase Storage (S3 protocol).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minio"
S3_SECRET_ACCESS_KEY="minio12345"
S3_BUCKET="vp-media"
S3_FORCE_PATH_STYLE="true"      # true for MinIO and Supabase Storage

# Secret used to sign short-lived stream-access tokens (Step 7). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STREAM_SIGNING_SECRET="dev-only-change-me"

# --- Production (Step 8) values ---
# Supabase (Postgres + Storage), Upstash (Redis) — all no credit card.
#   DATABASE_URL: Supabase "Transaction pooler" URI (port 6543) + &pgbouncer=true
#   DIRECT_URL:   Supabase "Direct connection" URI (port 5432)
#   REDIS_URL:    Upstash rediss:// URL (TLS)
#   S3_ENDPOINT:  https://<project-ref>.supabase.co/storage/v1/s3
#   S3_REGION:    the region shown in Supabase Storage settings (e.g. us-east-1)
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY: generated in Storage -> S3 keys
#   S3_FORCE_PATH_STYLE="true"
