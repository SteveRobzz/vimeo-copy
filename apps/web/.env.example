# Next.js app env. Copy to .env.local for local dev.
DATABASE_URL="postgresql://vp:vp@localhost:5432/vp?schema=public"
REDIS_URL="redis://localhost:6379"

# Object storage. Local dev = MinIO; prod = Cloudflare R2 (same S3 API).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minio"
S3_SECRET_ACCESS_KEY="minio12345"
S3_BUCKET="vp-media"
S3_FORCE_PATH_STYLE="true"      # true for MinIO; omit/false for R2

# Filled in during later steps:
# AUTH_SECRET=
# For R2 (Step 8):
#   S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
#   S3_FORCE_PATH_STYLE="false"
